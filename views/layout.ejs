<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Discord Partner Bot</title>
    <meta name="description" content="Professional Discord Partnership Bot with automated bumping and approval system. Grow your Discord server with SkyVPS360.xyz Partner Bot.">
    <meta name="keywords" content="discord bot, partnership bot, server growth, discord partnerships, automated bumping">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= process.env.SITE_URL || 'https://localhost:4444' %>">
    <meta property="og:title" content="<%= title %> | Discord Partner Bot">
    <meta property="og:description" content="Professional Discord Partnership Bot with automated bumping and approval system.">
    <meta property="og:image" content="<%= process.env.SITE_URL || 'https://localhost:4444' %>/images/og-image.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="<%= process.env.SITE_URL || 'https://localhost:4444' %>">
    <meta property="twitter:title" content="<%= title %> | Discord Partner Bot">
    <meta property="twitter:description" content="Professional Discord Partnership Bot with automated bumping and approval system.">
    <meta property="twitter:image" content="<%= process.env.SITE_URL || 'https://localhost:4444' %>/images/og-image.png">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Additional page-specific styles -->
    <% if (typeof additionalCSS !== 'undefined') { %>
        <% additionalCSS.forEach(css => { %>
            <link rel="stylesheet" href="<%= css %>">
        <% }) %>
    <% } %>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <div class="logo-icon">P</div>
                Partner Bot
            </a>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/servers">Servers</a></li>
                <li><a href="/docs">Documentation</a></li>
                <% if (user) { %>
                    <li><a href="/profile">Profile</a></li>
                    <li><a href="/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/auth/discord" class="btn btn-primary">Login with Discord</a></li>
                <% } %>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="/privacy">Privacy Policy</a>
                <a href="/terms">Terms of Service</a>
                <a href="/support">Support</a>
                <a href="https://discord.gg/your-support-server" target="_blank">Discord Server</a>
                <a href="https://skyvps360.xyz" target="_blank">SkyVPS360.xyz</a>
            </div>
            <p class="footer-text">
                &copy; <%= new Date().getFullYear() %> SkyVPS360.xyz Partner Bot. All rights reserved.<br>
                Powered by the $3 Ryzen Epyc KVM VPS Provider <a href="https://skyvps360.xyz" target="_blank" style="color: var(--primary-color);">SkyVPS360.xyz</a>
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/js/main.js"></script>
    
    <!-- Additional page-specific scripts -->
    <% if (typeof additionalJS !== 'undefined') { %>
        <% additionalJS.forEach(js => { %>
            <script src="<%= js %>"></script>
        <% }) %>
    <% } %>

    <!-- Analytics (if needed) -->
    <% if (process.env.GOOGLE_ANALYTICS_ID) { %>
        <!-- Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GOOGLE_ANALYTICS_ID %>"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '<%= process.env.GOOGLE_ANALYTICS_ID %>');
        </script>
    <% } %>
</body>
</html>